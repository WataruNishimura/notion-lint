              },
              "required": {
                "description": "If true, the value must not be empty. Default false",
                "type": "boolean"
              },
              "optional": {
                "description": "If true, the property may be absent from the page (if it is present, the other checks still apply). Default false",
                "type": "boolean"
              },
              "options": {
                "minItems": 1,
                "uniqueItems": true,
                "description": "Allowed option names. If omitted, every option in the data source is allowed",
                "type": "array",
                "items": {
                  "minLength": 1,
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "if": {
