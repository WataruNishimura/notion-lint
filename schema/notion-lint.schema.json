{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "notion-lint config",
  "description": "notion-lint config. Has type (the type for the page checked with --page), targets, or both",
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "type"
      ]
    },
    {
      "required": [
        "targets"
      ]
    }
  ],
  "definitions": {
    "DocType": {
      "$id": "DocType",
      "title": "DocType",
      "additionalProperties": false,
      "description": "Document type. Checks whether a page matches it",
      "type": "object",
      "properties": {
        "name": {
          "minLength": 1,
          "description": "Name of the type (shown in results)",
          "type": "string"
        },
        "fromTemplate": {
          "additionalProperties": false,
          "description": "Build body from the headings of a template page (headings only, all required, nested as in the template). A body written in the same type replaces it (no merge). Other settings such as properties apply as written",
          "type": "object",
          "required": [
            "page"
          ],
          "properties": {
            "page": {
              "minLength": 1,
              "description": "ID or URL of the template page",
              "type": "string"
            }
          }
        },
        "properties": {
          "description": "Type for each property name",
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "PropSpec"
            }
          }
        },
        "body": {
          "description": "Body skeleton",
          "type": "array",
          "items": {
            "$ref": "BodyNode"
          }
        },
        "headings": {
          "additionalProperties": false,
          "description": "Rules for the whole heading structure",
          "type": "object",
          "properties": {
            "noSkipLevel": {
              "description": "Do not skip heading levels (e.g. H3 right after H1). Default false",
              "type": "boolean"
            },
            "allowExtra": {
              "description": "Allow headings that are not in body. Default true",
              "type": "boolean"
            }
          }
        },
        "text": {
          "additionalProperties": false,
          "description": "Check of the notation in the body",
          "type": "object",
          "properties": {
            "textlint": {
              "additionalProperties": false,
              "description": "Check the body with textlint",
              "type": "object",
              "properties": {
                "presets": {
                  "description": "textlint preset names (e.g. ja-technical-writing)",
                  "type": "array",
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "rules": {
                  "description": "textlint rule names and their settings (true / false / options)",
                  "type": "object",
                  "patternProperties": {
                    "^(.*)$": {
                      "type": [
                        "boolean",
                        "object"
                      ]
                    }
                  }
                },
                "prh": {
                  "description": "Paths to prh dictionary files (relative to the config file)",
                  "type": "array",
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "numbering": {
          "additionalProperties": false,
          "description": "Rules for the section numbers written by hand in headings",
          "type": "object",
          "required": [
            "format"
          ],
          "properties": {
            "format": {
              "additionalProperties": false,
              "minProperties": 1,
              "type": "object",
              "properties": {
                "h1": {
                  "pattern": "\\{title\\}",
                  "description": "Format for H1 headings. {n} is each part of the number, {title} is the title (e.g. \"{n}.{n} {title}\")",
                  "type": "string"
                },
                "h2": {
                  "pattern": "\\{title\\}",
                  "description": "Format for H2 headings. {n} is each part of the number, {title} is the title (e.g. \"{n}.{n} {title}\")",
                  "type": "string"
                },
                "h3": {
                  "pattern": "\\{title\\}",
                  "description": "Format for H3 headings. {n} is each part of the number, {title} is the title (e.g. \"{n}.{n} {title}\")",
                  "type": "string"
                }
              }
            },
            "sequential": {
              "description": "Numbers run 1, 2, 3 without gaps or duplicates. Default true",
              "type": "boolean"
            }
          }
        },
        "references": {
          "additionalProperties": false,
          "description": "Match section references in the body against the headings",
          "type": "object",
          "required": [
            "patterns"
          ],
          "properties": {
            "patterns": {
              "minItems": 1,
              "type": "array",
              "items": {
                "description": "Reference forms in the body. A string is a template containing {n} (section number) and {title} (heading), e.g. \"see section {n}\". { pattern } is a regex with named groups n and title",
                "type": [
                  "string",
                  "object"
                ],
                "minLength": 1,
                "if": {
                  "type": "object"
                },
                "then": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "pattern"
                  ],
                  "properties": {
                    "pattern": {
                      "format": "regex",
                      "description": "Regex source in JavaScript (without the surrounding slashes)",
                      "type": "string"
                    },
                    "flags": {
                      "pattern": "^[dgimsuvy]*$",
                      "description": "Regex flags (e.g. iu)",
                      "type": "string"
                    }
                  }
                }
              }
            },
            "notionLinks": {
              "description": "Also check the link text of links to blocks and the heading they point to. Default false",
              "type": "boolean"
            },
            "ignore": {
              "type": "array",
              "items": {
                "description": "Words not to treat as references (a string matches exactly, or a regex)",
                "type": [
                  "string",
                  "object"
                ],
                "minLength": 1,
                "if": {
                  "type": "object"
                },
                "then": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "pattern"
                  ],
                  "properties": {
                    "pattern": {
                      "format": "regex",
                      "description": "Regex source in JavaScript (without the surrounding slashes)",
                      "type": "string"
                    },
                    "flags": {
                      "pattern": "^[dgimsuvy]*$",
                      "description": "Regex flags (e.g. iu)",
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "BodyNode": {
      "$id": "BodyNode",
      "title": "BodyNode",
      "description": "One element of the body skeleton. An element with heading is a heading; one with block is any other block. The array must appear in this order, from top to bottom",
      "type": "object",
      "anyOf": [
        {
          "required": [
            "heading"
          ]
        },
        {
          "required": [
            "block"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "heading"
            ]
          },
          "then": {
            "additionalProperties": false,
            "description": "Heading",
            "type": "object",
            "required": [
              "heading",
              "title"
            ],
            "properties": {
              "heading": {
                "description": "Heading level (1 to 3)",
                "type": "integer",
                "enum": [
                  1,
                  2,
                  3
                ]
              },
              "title": {
                "description": "Heading text. A string must match exactly; { pattern } is a regex. Matched against the text without the section number (numbering)",
                "type": [
                  "string",
                  "object"
                ],
                "minLength": 1,
                "if": {
                  "type": "object"
                },
                "then": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "pattern"
                  ],
                  "properties": {
                    "pattern": {
                      "format": "regex",
                      "description": "Regex source in JavaScript (without the surrounding slashes)",
                      "type": "string"
                    },
                    "flags": {
                      "pattern": "^[dgimsuvy]*$",
                      "description": "Regex flags (e.g. iu)",
                      "type": "string"
                    }
                  }
                }
              },
              "optional": {
                "description": "If true, this heading may be absent. Default false",
                "type": "boolean"
              },
              "children": {
                "description": "Skeleton under this heading (up to the next heading of the same or a higher level)",
                "type": "array",
                "items": {
                  "$ref": "BodyNode"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "block"
            ]
          },
          "then": {
            "additionalProperties": false,
            "description": "A block other than a heading",
            "type": "object",
            "required": [
              "block"
            ],
            "properties": {
              "block": {
                "description": "Block kind. list accepts either a bulleted or a numbered list. any accepts any kind",
                "type": "string",
                "enum": [
                  "any",
                  "paragraph",
                  "list",
                  "bulleted_list_item",
                  "numbered_list_item",
                  "to_do",
                  "toggle",
                  "quote",
                  "callout",
                  "code",
                  "table",
                  "image",
                  "divider"
                ]
              },
              "min": {
                "minimum": 0,
                "description": "Lower bound on the number of blocks of this kind at this position. Default 1 (0 makes it optional)",
                "type": "integer"
              },
              "max": {
                "minimum": 1,
                "description": "Upper bound, same as above. Default: no upper bound",
                "type": "integer"
              },
              "children": {
                "description": "Skeleton of the child blocks of this block (e.g. the contents of a toggle)",
                "type": "array",
                "items": {
                  "$ref": "BodyNode"
                }
              }
            }
          }
        }
      ]
    },
    "PropSpec": {
      "$id": "PropSpec",
      "title": "PropSpec",
      "description": "Property type. type is the Notion API property type name",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "title",
            "rich_text",
            "number",
            "select",
            "multi_select",
            "status",
            "date",
            "people",
            "files",
            "checkbox",
            "url",
            "email",
            "phone_number",
            "relation"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "title"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "description": "Title property",
            "dependencies": {
              "flags": [
                "pattern"
              ]
            },
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "title",
                "type": "string"
              },
              "required": {
                "description": "If true, the value must not be empty. Default false",
                "type": "boolean"
              },
              "optional": {
                "description": "If true, the property may be absent from the page (if it is present, the other checks still apply). Default false",
                "type": "boolean"
              },
              "pattern": {
                "format": "regex",
                "description": "Regex source that the value (plain text) must match. Not applied to empty values",
                "type": "string"
              },
              "flags": {
                "pattern": "^[dgimsuvy]*$",
                "description": "Flags for pattern (e.g. iu)",
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "rich_text"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "description": "Rich text property",
            "dependencies": {
              "flags": [
                "pattern"
              ]
            },
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "rich_text",
                "type": "string"
              },
              "required": {
                "description": "If true, the value must not be empty. Default false",
                "type": "boolean"
              },
              "optional": {
                "description": "If true, the property may be absent from the page (if it is present, the other checks still apply). Default false",
                "type": "boolean"
              },
              "pattern": {
                "format": "regex",
                "description": "Regex source that the value (plain text) must match. Not applied to empty values",
                "type": "string"
              },
              "flags": {
                "pattern": "^[dgimsuvy]*$",
                "description": "Flags for pattern (e.g. iu)",
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "number"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "description": "Number property",
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "number",
                "type": "string"
              },
              "required": {
                "description": "If true, the value must not be empty. Default false",
                "type": "boolean"
              },
              "optional": {
                "description": "If true, the property may be absent from the page (if it is present, the other checks still apply). Default false",
                "type": "boolean"
              },
              "min": {
                "description": "Lower bound of the value",
                "type": "number"
              },
              "max": {
                "description": "Upper bound of the value",
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "select"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "description": "Select property",
            "type": "object",
