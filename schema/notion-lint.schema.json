            "description": "Relation property",
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "relation",
                "type": "string"
              },
              "required": {
                "description": "If true, the value must not be empty. Default false",
                "type": "boolean"
              },
              "optional": {
                "description": "If true, the property may be absent from the page (if it is present, the other checks still apply). Default false",
                "type": "boolean"
              },
              "min": {
                "minimum": 0,
                "description": "Lower bound on the number of items",
                "type": "integer"
              },
              "max": {
                "minimum": 0,
                "description": "Upper bound on the number of items",
                "type": "integer"
              }
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Location of the schema for editors (ignored)",
      "type": "string"
    },
    "type": {
      "description": "Type applied to the page given with --page",
      "$ref": "DocType"
    },
    "targets": {
      "minItems": 1,
      "type": "array",
      "items": {
        "description": "Which type applies to which pages. Has either dataSource or page",
        "type": "object",
        "anyOf": [
          {
            "required": [
              "dataSource"
            ]
          },
          {
            "required": [
              "page"
            ]
          }
        ],
        "allOf": [
          {
            "if": {
              "required": [
                "dataSource"
              ]
            },
            "then": {
              "additionalProperties": false,
              "description": "Apply a type to the pages of a data source",
              "type": "object",
              "required": [
                "dataSource",
                "type"
              ],
              "properties": {
                "dataSource": {
                  "minLength": 1,
                  "description": "Data source ID or URL",
                  "type": "string"
                },
                "where": {
                  "description": "Property names and values. Only pages where all of them match are checked",
                  "type": "object",
                  "patternProperties": {
                    "^(.*)$": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  }
                },
                "type": {
                  "$ref": "DocType"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "page"
              ]
            },
            "then": {
              "additionalProperties": false,
              "description": "Apply a type to one page",
              "type": "object",
              "required": [
                "page",
                "type"
              ],
              "properties": {
                "page": {
                  "minLength": 1,
                  "description": "Page ID or URL",
                  "type": "string"
                },
                "type": {
                  "$ref": "DocType"
                }
              }
            }
          }
        ]
      }
    }
  }
}
