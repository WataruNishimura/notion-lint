{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "notion-lint config",
  "description": "notion-lint の設定。type (--page で検査するページの型) か targets のどちらか、または両方を持つ",
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "type"
      ]
    },
    {
      "required": [
        "targets"
      ]
    }
  ],
  "definitions": {
    "DocType": {
      "$id": "DocType",
      "title": "DocType",
      "additionalProperties": false,
      "description": "文書の型。ページがこれに合うかを検査する",
      "type": "object",
      "properties": {
        "name": {
          "minLength": 1,
          "description": "型の名前 (結果の表示に使う)",
          "type": "string"
        },
        "fromTemplate": {
          "additionalProperties": false,
          "description": "テンプレートページから body を作る。同じ型に書いた body / properties はテンプレートからの分より優先する",
          "type": "object",
          "required": [
            "page"
          ],
          "properties": {
            "page": {
              "minLength": 1,
              "description": "テンプレートページの ID か URL",
              "type": "string"
            }
          }
        },
        "properties": {
          "description": "プロパティ名ごとの型",
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "$ref": "PropSpec"
            }
          }
        },
        "body": {
          "description": "本文の骨格",
          "type": "array",
          "items": {
            "$ref": "BodyNode"
          }
        },
        "headings": {
          "additionalProperties": false,
          "description": "見出し全体の規則",
          "type": "object",
          "properties": {
            "noSkipLevel": {
              "description": "見出しのレベルを飛ばさない (H1 の次に H3 など)。既定は false",
              "type": "boolean"
            },
            "allowExtra": {
              "description": "body にない見出しを許す。既定は true",
              "type": "boolean"
            }
          }
        },
        "text": {
          "additionalProperties": false,
          "description": "本文の表記の検査",
          "type": "object",
          "properties": {
            "textlint": {
              "additionalProperties": false,
              "description": "textlint で本文を検査する",
              "type": "object",
              "properties": {
                "presets": {
                  "description": "textlint のプリセット名 (例: ja-technical-writing)",
                  "type": "array",
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "rules": {
                  "description": "textlint のルール名と設定 (true / false / オプション)",
                  "type": "object",
                  "patternProperties": {
                    "^(.*)$": {
                      "type": [
                        "boolean",
                        "object"
                      ]
                    }
                  }
                },
                "prh": {
                  "description": "prh の辞書ファイルのパス (設定ファイルからの相対パス)",
                  "type": "array",
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "numbering": {
          "additionalProperties": false,
          "description": "見出しに手で書かれた章番号の規則",
          "type": "object",
          "required": [
            "format"
          ],
          "properties": {
            "format": {
              "additionalProperties": false,
              "minProperties": 1,
              "type": "object",
              "properties": {
                "h1": {
                  "pattern": "\\{title\\}",
                  "description": "H1 の書き方。{n} が番号の各段、{title} がタイトル (例: \"{n}.{n} {title}\")",
                  "type": "string"
                },
                "h2": {
                  "pattern": "\\{title\\}",
                  "description": "H2 の書き方。{n} が番号の各段、{title} がタイトル (例: \"{n}.{n} {title}\")",
                  "type": "string"
                },
                "h3": {
                  "pattern": "\\{title\\}",
                  "description": "H3 の書き方。{n} が番号の各段、{title} がタイトル (例: \"{n}.{n} {title}\")",
                  "type": "string"
                }
              }
            },
            "sequential": {
              "description": "番号が 1, 2, 3 と抜けや重複なく続く。既定は true",
              "type": "boolean"
            }
          }
        },
        "references": {
          "additionalProperties": false,
          "description": "本文中の章への参照と見出しの照合",
          "type": "object",
          "required": [
            "patterns"
          ],
          "properties": {
            "patterns": {
              "minItems": 1,
              "type": "array",
              "items": {
                "description": "本文中の参照の書き方。文字列は {n} (章番号) と {title} (見出し) を含むひな形 (例: \"{n}章\")。{ pattern } なら名前付きグループ n / title を持つ正規表現",
                "type": [
                  "string",
                  "object"
                ],
                "minLength": 1,
                "if": {
                  "type": "object"
                },
                "then": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "pattern"
                  ],
                  "properties": {
                    "pattern": {
                      "format": "regex",
                      "description": "JavaScript の正規表現のソース (スラッシュで囲まない)",
                      "type": "string"
                    },
                    "flags": {
                      "pattern": "^[dgimsuvy]*$",
                      "description": "正規表現のフラグ (例: iu)",
                      "type": "string"
                    }
                  }
                }
              }
            },
            "notionLinks": {
              "description": "ブロックへのリンクの文字列とリンク先の見出しも照合する。既定は false",
              "type": "boolean"
            },
            "ignore": {
              "type": "array",
              "items": {
                "description": "参照として扱わない語 (文字列は完全一致、または正規表現)",
                "type": [
                  "string",
                  "object"
                ],
                "minLength": 1,
                "if": {
                  "type": "object"
                },
                "then": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "pattern"
                  ],
                  "properties": {
                    "pattern": {
                      "format": "regex",
                      "description": "JavaScript の正規表現のソース (スラッシュで囲まない)",
                      "type": "string"
                    },
                    "flags": {
                      "pattern": "^[dgimsuvy]*$",
                      "description": "正規表現のフラグ (例: iu)",
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "BodyNode": {
      "$id": "BodyNode",
      "title": "BodyNode",
      "description": "本文の骨格の 1 要素。heading を持てば見出し、block を持てばそれ以外のブロック。配列の上から順に並ぶことを要求する",
      "type": "object",
      "anyOf": [
        {
          "required": [
            "heading"
          ]
        },
        {
          "required": [
            "block"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "heading"
            ]
          },
          "then": {
            "additionalProperties": false,
            "description": "見出し",
            "type": "object",
            "required": [
              "heading",
              "title"
            ],
            "properties": {
              "heading": {
                "description": "見出しのレベル (1〜3)",
                "type": "integer",
                "enum": [
                  1,
                  2,
                  3
                ]
              },
              "title": {
                "description": "見出しの文字列。文字列なら完全一致、{ pattern } なら正規表現。章番号 (numbering) を除いた部分と照合する",
                "type": [
                  "string",
                  "object"
                ],
                "minLength": 1,
                "if": {
                  "type": "object"
                },
                "then": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "pattern"
                  ],
                  "properties": {
                    "pattern": {
                      "format": "regex",
                      "description": "JavaScript の正規表現のソース (スラッシュで囲まない)",
                      "type": "string"
                    },
                    "flags": {
                      "pattern": "^[dgimsuvy]*$",
                      "description": "正規表現のフラグ (例: iu)",
                      "type": "string"
                    }
                  }
                }
              },
              "optional": {
                "description": "true ならこの見出しがなくてもよい。既定は false",
                "type": "boolean"
              },
              "children": {
                "description": "見出しの下 (次の同レベル以上の見出しまで) の骨格",
                "type": "array",
                "items": {
                  "$ref": "BodyNode"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "block"
            ]
          },
          "then": {
            "additionalProperties": false,
            "description": "見出し以外のブロック",
            "type": "object",
            "required": [
              "block"
            ],
            "properties": {
              "block": {
                "description": "ブロックの種類。list は箇条書きと番号付きリストのどちらでもよい。any は種類を問わない",
                "type": "string",
                "enum": [
                  "any",
                  "paragraph",
                  "list",
                  "bulleted_list_item",
                  "numbered_list_item",
                  "to_do",
                  "toggle",
                  "quote",
                  "callout",
                  "code",
                  "table",
                  "image",
                  "divider"
                ]
              },
              "min": {
                "minimum": 0,
                "description": "この位置に続く、この種類のブロックの数の下限。既定は 1 (0 なら省略可)",
                "type": "integer"
              },
              "max": {
                "minimum": 1,
                "description": "同じく上限。既定は上限なし",
                "type": "integer"
              },
              "children": {
                "description": "このブロックの子ブロック (トグルの中身など) の骨格",
                "type": "array",
                "items": {
                  "$ref": "BodyNode"
                }
              }
            }
          }
        }
      ]
    },
    "PropSpec": {
      "$id": "PropSpec",
      "title": "PropSpec",
      "description": "プロパティの型。type は Notion API のプロパティ型名",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "title",
            "rich_text",
            "number",
            "select",
            "multi_select",
            "status",
            "date",
            "people",
            "files",
            "checkbox",
            "url",
            "email",
            "phone_number",
            "relation"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "title"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "description": "タイトルプロパティ",
            "dependencies": {
              "flags": [
                "pattern"
              ]
            },
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "title",
                "type": "string"
              },
              "required": {
                "description": "true なら値が空であってはならない。既定は false",
                "type": "boolean"
              },
              "optional": {
                "description": "true ならページにこのプロパティ自体がなくてもよい (あれば他の条件を見る)。既定は false",
                "type": "boolean"
              },
              "pattern": {
                "format": "regex",
                "description": "値 (プレーンテキスト) が合うべき正規表現のソース。空の値には適用しない",
                "type": "string"
              },
              "flags": {
                "pattern": "^[dgimsuvy]*$",
                "description": "pattern のフラグ (例: iu)",
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "rich_text"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "description": "テキストプロパティ",
            "dependencies": {
              "flags": [
                "pattern"
              ]
            },
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "rich_text",
                "type": "string"
              },
              "required": {
                "description": "true なら値が空であってはならない。既定は false",
                "type": "boolean"
              },
              "optional": {
                "description": "true ならページにこのプロパティ自体がなくてもよい (あれば他の条件を見る)。既定は false",
                "type": "boolean"
              },
              "pattern": {
                "format": "regex",
                "description": "値 (プレーンテキスト) が合うべき正規表現のソース。空の値には適用しない",
                "type": "string"
              },
              "flags": {
                "pattern": "^[dgimsuvy]*$",
                "description": "pattern のフラグ (例: iu)",
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "number"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "description": "数値プロパティ",
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "number",
                "type": "string"
              },
              "required": {
                "description": "true なら値が空であってはならない。既定は false",
                "type": "boolean"
              },
              "optional": {
                "description": "true ならページにこのプロパティ自体がなくてもよい (あれば他の条件を見る)。既定は false",
                "type": "boolean"
              },
              "min": {
                "description": "値の下限",
                "type": "number"
              },
              "max": {
                "description": "値の上限",
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "select"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "description": "セレクトプロパティ",
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "select",
                "type": "string"
              },
              "required": {
                "description": "true なら値が空であってはならない。既定は false",
                "type": "boolean"
              },
              "optional": {
                "description": "true ならページにこのプロパティ自体がなくてもよい (あれば他の条件を見る)。既定は false",
                "type": "boolean"
              },
              "options": {
                "minItems": 1,
                "uniqueItems": true,
                "description": "許す選択肢の名前。省略するとデータソースにある選択肢をすべて許す",
                "type": "array",
                "items": {
                  "minLength": 1,
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "multi_select"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "description": "マルチセレクトプロパティ",
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "multi_select",
                "type": "string"
              },
              "required": {
                "description": "true なら値が空であってはならない。既定は false",
                "type": "boolean"
              },
              "optional": {
                "description": "true ならページにこのプロパティ自体がなくてもよい (あれば他の条件を見る)。既定は false",
                "type": "boolean"
              },
              "options": {
                "minItems": 1,
                "uniqueItems": true,
                "description": "許す選択肢の名前。省略するとデータソースにある選択肢をすべて許す",
                "type": "array",
                "items": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "min": {
                "minimum": 0,
                "description": "要素数の下限",
                "type": "integer"
              },
              "max": {
                "minimum": 0,
                "description": "要素数の上限",
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "status"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "description": "ステータスプロパティ",
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "status",
                "type": "string"
              },
              "required": {
                "description": "true なら値が空であってはならない。既定は false",
                "type": "boolean"
              },
              "optional": {
                "description": "true ならページにこのプロパティ自体がなくてもよい (あれば他の条件を見る)。既定は false",
                "type": "boolean"
              },
              "options": {
                "minItems": 1,
                "uniqueItems": true,
                "description": "許す選択肢の名前。省略するとデータソースにある選択肢をすべて許す",
                "type": "array",
                "items": {
                  "minLength": 1,
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "date"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "description": "日付プロパティ",
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "date",
                "type": "string"
              },
              "required": {
                "description": "true なら値が空であってはならない。既定は false",
                "type": "boolean"
              },
              "optional": {
                "description": "true ならページにこのプロパティ自体がなくてもよい (あれば他の条件を見る)。既定は false",
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "people"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "description": "ユーザープロパティ",
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "people",
                "type": "string"
              },
              "required": {
                "description": "true なら値が空であってはならない。既定は false",
                "type": "boolean"
              },
              "optional": {
                "description": "true ならページにこのプロパティ自体がなくてもよい (あれば他の条件を見る)。既定は false",
                "type": "boolean"
              },
              "min": {
                "minimum": 0,
                "description": "要素数の下限",
                "type": "integer"
              },
              "max": {
                "minimum": 0,
                "description": "要素数の上限",
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "files"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "description": "ファイルプロパティ",
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "files",
                "type": "string"
              },
              "required": {
                "description": "true なら値が空であってはならない。既定は false",
                "type": "boolean"
              },
              "optional": {
                "description": "true ならページにこのプロパティ自体がなくてもよい (あれば他の条件を見る)。既定は false",
                "type": "boolean"
              },
              "min": {
                "minimum": 0,
                "description": "要素数の下限",
                "type": "integer"
              },
              "max": {
                "minimum": 0,
                "description": "要素数の上限",
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "checkbox"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "description": "チェックボックスプロパティ",
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "checkbox",
                "type": "string"
              },
              "required": {
                "description": "true なら値が空であってはならない。既定は false",
                "type": "boolean"
              },
              "optional": {
                "description": "true ならページにこのプロパティ自体がなくてもよい (あれば他の条件を見る)。既定は false",
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "url"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "description": "URL プロパティ",
            "dependencies": {
              "flags": [
                "pattern"
              ]
            },
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "url",
                "type": "string"
              },
              "required": {
                "description": "true なら値が空であってはならない。既定は false",
                "type": "boolean"
              },
              "optional": {
                "description": "true ならページにこのプロパティ自体がなくてもよい (あれば他の条件を見る)。既定は false",
                "type": "boolean"
              },
              "pattern": {
                "format": "regex",
                "description": "値 (プレーンテキスト) が合うべき正規表現のソース。空の値には適用しない",
                "type": "string"
              },
              "flags": {
                "pattern": "^[dgimsuvy]*$",
                "description": "pattern のフラグ (例: iu)",
